#compdef pm
#
# Zsh completion for `pm`.
#
# Dynamic value lists (project names, repo names, worktrees) are pulled
# from the `pm __complete` hidden sub-app. Static parts (subcommand +
# flag names) live inline here because they're cheaper than invoking
# Python on every keypress.
#
# Install: add the parent directory to $fpath and reinitialise compinit.
#   fpath=(/path/to/integrations $fpath)
#   autoload -Uz compinit && compinit
#
# Scope notes: `pm stacker` is covered at subcommand-name granularity
# only; per-command flag/positional completion is deferred.

# ---------- helpers ----------

_pm_extract_flag() {
  # _pm_extract_flag --flag [--alias ...]
  # Scan the current $words for any of the listed flag names; echo the
  # value immediately after the first match, or nothing.
  local flag i=2
  while (( i < ${#words} )); do
    for flag; do
      [[ $words[i] == $flag ]] && { print -r -- "$words[i+1]"; return 0; }
    done
    (( i++ ))
  done
  return 1
}

_pm_projects() {
  local -a items
  items=(${(f)"$(command pm __complete projects 2>/dev/null)"})
  _describe -t projects 'project' items
}

_pm_repos() {
  local -a items
  items=(${(f)"$(command pm __complete repos 2>/dev/null)"})
  _describe -t repos 'repo' items
}

_pm_wt_list() {
  # Comma-list completion for --wt. `_values -s ,` handles subtraction
  # of already-typed values automatically.
  local project=$(_pm_extract_flag --project -p)
  local -a args items
  (( ${#project} )) && args=(--project "$project")
  items=(${(f)"$(command pm __complete worktrees $args 2>/dev/null)"})
  _values -s , 'worktree' $items
}

# ---------- per-group dispatchers ----------

_pm_project_wt() {
  local -a subs=(
    'create:Add worktree(s) to an existing project'
    'attach:Re-attach worktrees (best-effort slot reclaim)'
    'detach:Detach worktrees: unlink forward + release pool row'
    'delete:Delete worktree row(s) from a project'
  )
  if (( CURRENT == 4 )); then
    _describe -t commands 'pm project wt' subs
    return
  fi
  case $words[4] in
    create)
      _arguments \
        '(-p --project)'{-p,--project}'[project name]:project:_pm_projects' \
        '*:spec:'
      ;;
    attach)
      _arguments \
        '(-p --project)'{-p,--project}'[project name]:project:_pm_projects' \
        '--wt[comma-separated worktree names]:worktrees:_pm_wt_list' \
        '--all[every worktree in the project]' \
        '--no-branch[skip saved-branch restore]'
      ;;
    detach)
      _arguments \
        '(-p --project)'{-p,--project}'[project name]:project:_pm_projects' \
        '--wt[comma-separated worktree names]:worktrees:_pm_wt_list' \
        '--all[every worktree in the project]' \
        '--dry-run[print the plan without mutating state]'
      ;;
    delete)
      _arguments \
        '(-p --project)'{-p,--project}'[project name]:project:_pm_projects' \
        '--wt[comma-separated worktree names]:worktrees:_pm_wt_list' \
        '--all[every worktree in the project]' \
        '--dry-run[print the plan without mutating state]'
      ;;
  esac
}

_pm_project() {
  local -a subs=(
    'create:Create a project (optionally with initial worktrees)'
    'delete:Delete a whole project'
    'ls:List projects'
    'status:Show health + db rows for a single project'
    'wt:Manage worktrees within a project'
  )
  if (( CURRENT == 3 )); then
    _describe -t commands 'pm project' subs
    return
  fi
  case $words[3] in
    create)
      _arguments \
        '1:project:' \
        '--wt[comma-separated worktrees: "<repo>" or "<name>:<repo>"]:'
      ;;
    delete)
      _arguments \
        '1:project:_pm_projects' \
        '--dry-run[print the plan without mutating state]'
      ;;
    ls)
      ;;
    status)
      _arguments '1:project:_pm_projects'
      ;;
    wt)
      _pm_project_wt
      ;;
  esac
}

_pm_pool() {
  local -a subs=(
    'ls:List pool slots with claim status'
    'add:Mint a new pool slot'
    'gc-ops:Release stacker-ops slots that have no live operation'
  )
  if (( CURRENT == 3 )); then
    _describe -t commands 'pm pool' subs
    return
  fi
  case $words[3] in
    ls|add)
      _arguments '1:repo:_pm_repos'
      ;;
  esac
}

_pm_repo() {
  local -a subs=(
    'ls:List canonical repos with branch + upstream status'
    'pull:Fetch + ff-only pull each canonical repo'
  )
  if (( CURRENT == 3 )); then
    _describe -t commands 'pm repo' subs
    return
  fi
  case $words[3] in
    pull)
      _arguments '--repo[comma-separated repo names]:repo:_pm_repos'
      ;;
  esac
}

_pm_stacker() {
  # Subcommand-name completion only; per-command flag/positional
  # completion is deferred (see plan).
  local -a subs=(
    'create:Create or adopt a tracked branch'
    'sync:Cherry-pick branches onto their parents'
    'push:Force-push + create/update PRs for a scope'
    'ls:Render the stack tree'
    'remove:Untrack a branch'
    'reparent:Move current branch onto a new parent'
    'split:Move commits onto a new child branch'
    'rename:Rename the current branch'
    'repair:Reset stored managed-base to match git'
    'log:Show commits since the managed base'
    'continue:Resume a paused stacker operation'
    'abort:Abort a paused stacker operation'
    'config:Get/set per-repo stacker config'
    'guard:Internal guardrails for Git hooks'
  )
  (( CURRENT == 3 )) && _describe -t commands 'pm stacker' subs
}

# ---------- top-level ----------

_pm() {
  local -a groups=(
    'project:manage projects'
    'pool:manage worktree pool'
    'repo:manage canonical repos under ~/.repos'
    'stacker:branch-stack tracking against pm'"'"'s pool'
    'check:verify invariants across pool and projects'
  )
  if (( CURRENT == 2 )); then
    _describe -t commands 'pm' groups
    return
  fi
  case $words[2] in
    project) _pm_project ;;
    pool)    _pm_pool ;;
    repo)    _pm_repo ;;
    stacker) _pm_stacker ;;
    check)
      _arguments '--fix[apply safe reconciliations]'
      ;;
  esac
}

_pm "$@"
